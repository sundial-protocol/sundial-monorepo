{
  "name": "@midgard-manager/tx-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "midgard-tx-generator": "./dist/bin/index.js"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit -p tsconfig.json --skipLibCheck",
    "dev": "tsc --watch",
    "start": "node ./dist/bin/index.js",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --max-warnings=0",
    "clean": "rm -rf dist",
    "test": "vitest run --mode=test",
    "test:watch": "vitest --mode=test"
  },
  "dependencies": {
    "@lucid-evolution/lucid": "^0.4.30",
    "@midgard-manager/tx-builder": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "effect": "^3.21.2",
    "fastq": "^1.20.1",
    "midgard-ts": "link:../../../midgard-ts",
    "p-limit": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.39.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "3.2.4"
  }
}
