{
  "runId": "institutional-5000",
  "description": "Institutional load tier (§8.1): exercises high-volume mempool depth, queue drain, block commitment throughput, and infrastructure resource behaviour. Sustains 5,000 TPS for 30 minutes with a mixed payload (70% one-to-one, 30% multi-output).",
  "nodeEndpoint": "http://localhost:3000",
  "prometheusEndpoint": "http://localhost:9090",
  "lokiEndpoint": "http://localhost:3100",
  "tempoEndpoint": "http://localhost:3200",
  "outputDir": "benchmark-runs",
  "seed": "institutional-5000-2026-05-18",
  "l1ProviderMode": "emulator",
  "walletMode": "test-wallet",
  "walletProvisioningNote": "test-wallet mode \u2014 node must be initialised with L2 genesis UTxOs for the generated test key",
  "transactionType": "mixed",
  "oneToOneRatio": 70,
  "tierDurationSeconds": 1800,
  "recoverySeconds": 300,
  "startTps": 5000,
  "maxTps": 5000,
  "stepMultiplier": 2,
  "batchSize": 500,
  "concurrency": 12,
  "retryAttempts": 3,
  "retryDelayMs": 500,
  "stopConditions": {
    "maxConsecutiveNodeProbeFailures": 5,
    "stopOnPrometheusDown": true,
    "stopOnCommitmentFailure": true,
    "stopOnMergeFailure": true,
    "maxRecoveryQueueSize": 200000,
    "maxRecoveryMempoolSize": 120000,
    "minUsefulThroughputRatio": 0.5
  }
}
