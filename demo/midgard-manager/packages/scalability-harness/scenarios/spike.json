{
  "runId": "spike",
  "description": "Peak spike tier (§8.1): simulates short burst demand at 2x the practical estimate target (49,970 TPS) for 5 minutes. Mixed payload (70% one-to-one, 30% multi-output). Measures recovery behaviour and service stability after burst load.",
  "nodeEndpoint": "http://localhost:3000",
  "prometheusEndpoint": "http://localhost:9090",
  "lokiEndpoint": "http://localhost:3100",
  "tempoEndpoint": "http://localhost:3200",
  "outputDir": "benchmark-runs",
  "seed": "spike-2026-05-18",
  "l1ProviderMode": "emulator",
  "walletMode": "test-wallet",
  "walletProvisioningNote": "test-wallet mode \u2014 node must be initialised with L2 genesis UTxOs for the generated test key",
  "transactionType": "mixed",
  "oneToOneRatio": 70,
  "tierDurationSeconds": 300,
  "recoverySeconds": 300,
  "startTps": 49970,
  "maxTps": 49970,
  "stepMultiplier": 2,
  "batchSize": 5000,
  "concurrency": 12,
  "retryAttempts": 1,
  "retryDelayMs": 150,
  "stopConditions": {
    "maxConsecutiveNodeProbeFailures": 5,
    "stopOnPrometheusDown": true,
    "stopOnCommitmentFailure": true,
    "stopOnMergeFailure": true,
    "maxRecoveryQueueSize": 1200000,
    "maxRecoveryMempoolSize": 800000,
    "minUsefulThroughputRatio": 0.25
  }
}
