{
  "runId": "baseline-100-800-replay",
  "description": "Replay variant of the baseline 100–800 TPS step-ramp using a fixed transaction corpus. Enables identical before/after comparison runs for optimization benchmarking per §13 of the scalability test plan.",
  "nodeEndpoint": "http://localhost:3000",
  "prometheusEndpoint": "http://localhost:9090",
  "lokiEndpoint": "http://localhost:3100",
  "tempoEndpoint": "http://localhost:3200",
  "outputDir": "benchmark-runs",
  "seed": "baseline-replay-2026-05-18",
  "l1ProviderMode": "emulator",
  "walletMode": "test-wallet",
  "walletProvisioningNote": "test-wallet mode \u2014 node must be initialised with L2 genesis UTxOs for the generated test key",
  "replayCorpusPath": "corpora/replay-baseline.json",
  "transactionType": "one-to-one",
  "tierDurationSeconds": 60,
  "recoverySeconds": 30,
  "startTps": 100,
  "maxTps": 800,
  "stepMultiplier": 2,
  "batchSize": 50,
  "concurrency": 4,
  "retryAttempts": 3,
  "retryDelayMs": 500,
  "stopConditions": {
    "maxConsecutiveNodeProbeFailures": 5,
    "stopOnPrometheusDown": false,
    "stopOnCommitmentFailure": true,
    "stopOnMergeFailure": false,
    "maxRecoveryQueueSize": 10000,
    "maxRecoveryMempoolSize": 5000,
    "minUsefulThroughputRatio": 0.5
  }
}
