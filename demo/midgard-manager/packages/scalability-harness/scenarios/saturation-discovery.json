{
  "runId": "saturation-discovery",
  "nodeEndpoint": "http://localhost:3000",
  "prometheusEndpoint": "http://localhost:9090",
  "outputDir": "benchmark-runs",
  "seed": "saturation-2026-05-18",
  "transactionType": "mixed",
  "oneToOneRatio": 70,
  "tierDurationSeconds": 120,
  "recoverySeconds": 60,
  "startTps": 50,
  "maxTps": 1600,
  "stepMultiplier": 2,
  "batchSize": 100,
  "concurrency": 8,
  "retryAttempts": 2,
  "retryDelayMs": 250,
  "stopConditions": {
    "maxConsecutiveNodeProbeFailures": 3,
    "stopOnPrometheusDown": true,
    "stopOnCommitmentFailure": true,
    "stopOnMergeFailure": true,
    "maxRecoveryQueueSize": 20000,
    "maxRecoveryMempoolSize": 10000,
    "minUsefulThroughputRatio": 0.3
  }
}
