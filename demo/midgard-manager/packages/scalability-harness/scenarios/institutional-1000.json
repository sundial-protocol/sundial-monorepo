{
  "runId": "institutional-1000",
  "description": "Institutional baseline tier (§8.1): proves stable operation above the initial TPS target. Sustains 1,000 TPS for 30 minutes with a mixed payload (70% one-to-one, 30% multi-output) and validates mempool, queue, commitment, and resource behaviour.",
  "nodeEndpoint": "http://localhost:3000",
  "prometheusEndpoint": "http://localhost:9090",
  "lokiEndpoint": "http://localhost:3100",
  "tempoEndpoint": "http://localhost:3200",
  "outputDir": "benchmark-runs",
  "seed": "institutional-1000-2026-05-18",
  "l1ProviderMode": "emulator",
  "walletMode": "test-wallet",
  "walletProvisioningNote": "test-wallet mode \u2014 node must be initialised with L2 genesis UTxOs for the generated test key",
  "transactionType": "mixed",
  "oneToOneRatio": 70,
  "tierDurationSeconds": 1800,
  "recoverySeconds": 300,
  "startTps": 1000,
  "maxTps": 1000,
  "stepMultiplier": 2,
  "batchSize": 200,
  "concurrency": 8,
  "retryAttempts": 3,
  "retryDelayMs": 500,
  "stopConditions": {
    "maxConsecutiveNodeProbeFailures": 5,
    "stopOnPrometheusDown": true,
    "stopOnCommitmentFailure": true,
    "stopOnMergeFailure": true,
    "maxRecoveryQueueSize": 40000,
    "maxRecoveryMempoolSize": 25000,
    "minUsefulThroughputRatio": 0.6
  }
}
