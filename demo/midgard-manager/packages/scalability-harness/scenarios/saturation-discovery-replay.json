{
  "runId": "saturation-discovery-replay",
  "description": "Replay variant of the saturation discovery run using a fixed transaction corpus. Enables identical before/after saturation comparisons for optimization benchmarking per §13 of the scalability test plan.",
  "nodeEndpoint": "http://localhost:3000",
  "prometheusEndpoint": "http://localhost:9090",
  "lokiEndpoint": "http://localhost:3100",
  "tempoEndpoint": "http://localhost:3200",
  "outputDir": "benchmark-runs",
  "seed": "saturation-replay-2026-05-18",
  "l1ProviderMode": "emulator",
  "walletMode": "test-wallet",
  "walletProvisioningNote": "test-wallet mode — node must be initialised with L2 genesis UTxOs for the generated test key",
  "replayCorpusPath": "corpora/replay-baseline.json",
  "transactionType": "mixed",
  "oneToOneRatio": 70,
  "tierDurationSeconds": 120,
  "recoverySeconds": 60,
  "startTps": 50,
  "maxTps": 1600,
  "stepMultiplier": 2,
  "txGeneratorTaskCostSeconds": 0.2,
  "retryAttempts": 2,
  "retryDelayMs": 250,
  "stopConditions": {
    "maxConsecutiveNodeProbeFailures": 3,
    "stopOnPrometheusDown": true,
    "stopOnCommitmentFailure": true,
    "stopOnMergeFailure": true,
    "maxRecoveryQueueSize": 20000,
    "maxRecoveryMempoolSize": 10000
  }
}
