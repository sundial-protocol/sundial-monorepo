{
  "runId": "warmup",
  "description": "Instrumentation warm-up tier (§8.1): confirms environment readiness, harness operation, dashboard population, and log/report pipelines before any formal load. Runs 100 TPS one-to-one for 10 minutes.",
  "nodeEndpoint": "http://localhost:3000",
  "prometheusEndpoint": "http://localhost:9090",
  "lokiEndpoint": "http://localhost:3100",
  "tempoEndpoint": "http://localhost:3200",
  "outputDir": "benchmark-runs",
  "seed": "warmup-2026-05-18",
  "l1ProviderMode": "emulator",
  "walletMode": "test-wallet",
  "walletProvisioningNote": "test-wallet mode \u2014 node must be initialised with L2 genesis UTxOs for the generated test key",
  "transactionType": "one-to-one",
  "tierDurationSeconds": 600,
  "recoverySeconds": 120,
  "startTps": 100,
  "maxTps": 100,
  "stepMultiplier": 2,
  "batchSize": 50,
  "concurrency": 4,
  "retryAttempts": 3,
  "retryDelayMs": 500,
  "stopConditions": {
    "maxConsecutiveNodeProbeFailures": 5,
    "stopOnPrometheusDown": true,
    "stopOnCommitmentFailure": true,
    "stopOnMergeFailure": true,
    "maxRecoveryQueueSize": 5000,
    "maxRecoveryMempoolSize": 5000,
    "minUsefulThroughputRatio": 0.7
  }
}
