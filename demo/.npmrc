# pnpm's trust-downgrade check compares a package version's provenance
# evidence against every version ever published, so it false-positives on
# any long-lived package that adopted npm provenance gradually (e.g.
# undici-types@6.21.0, chokidar@4.0.3) even with no actual incident.
# Real supply-chain compromises get pulled from the registry within days,
# so only flag downgrades on versions published recently.
trust-policy-ignore-after=129600
# min-release-age is in days (unlike trust-policy-ignore-after, which is minutes).
min-release-age=7
