# Workspace-level installed deps and build artifacts — rebuilt fresh inside Docker
node_modules
*/node_modules
*/dist
*/*.tgz

# Packages and dirs not needed for the midgard-node image build
midgard-manager
coverage
.tmp
temp
gitleaks-report.json

# Midgard node runtime/build-unrelated or mutable directories.
# Excluding these prevents large and frequently changing files from
# invalidating Docker build cache layers.
midgard-node/infra
midgard-node/db
midgard-node/test-mpt-db
midgard-node/tempo-data
