{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "iconColor": "yellow",
        "name": "Node restart / deploy",
        "expr": "changes(midgard_node_start_time_seconds{job=\"sundial_nodes\"}[$__interval]) > 0",
        "titleFormat": "Node restart",
        "textFormat": "midgard_node_start_time_seconds changed",
        "step": "60s"
      }
    ]
  },
  "description": "SLO compliance and error-budget view for the Sundial node. Backs the retrospective reliability report. Uses the slo:* recording rules generated from slo/slo.json.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "preload": false,
  "refresh": "1m",
  "schemaVersion": 42,
  "tags": ["sundial", "slo", "reliability"],
  "templating": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Sundial Node — Reliability & SLOs",
  "uid": "sundial-reliability",
  "version": 1,
  "panels": [
    {
      "type": "row",
      "title": "SLO compliance (selected time range)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Ingress acceptance (2xx /submit)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "slo:submit_ingress_availability:ratio_rate1h",
          "legendFormat": "1h",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "End-to-end tx success",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "slo:tx_end_to_end_success:ratio_rate1h",
          "legendFormat": "1h",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "L1 commitment success",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 0.999 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "slo:l1_commitment_success:ratio_rate1h",
          "legendFormat": "1h",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Merge success",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 0.999 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "slo:merge_success:ratio_rate1h",
          "legendFormat": "1h",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Success ratio (rolling 1h) vs objectives",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.9,
          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["min", "lastNotNull"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:submit_ingress_availability:ratio_rate1h", "legendFormat": "submit ingress", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:tx_end_to_end_success:ratio_rate1h", "legendFormat": "e2e tx", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:l1_commitment_success:ratio_rate1h", "legendFormat": "l1 commitment", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:merge_success:ratio_rate1h", "legendFormat": "merge", "refId": "D" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 (rolling 1h) vs objectives",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 7,
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "lastNotNull"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:submit_ingress_latency:p95_1h", "legendFormat": "submit p95 (obj 1s)", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:inclusion_latency:p95_1h", "legendFormat": "inclusion p95 (obj 20s)", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:submit_ingress_latency:p99_1h", "legendFormat": "submit p99", "refId": "C" }
      ]
    },
    {
      "type": "row",
      "title": "Error budget",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 8,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Error budget remaining (fraction of 30d budget)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 9,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 0.0001 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:submit_ingress_availability:error_budget_remaining", "legendFormat": "submit ingress", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:tx_end_to_end_success:error_budget_remaining", "legendFormat": "e2e tx", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:l1_commitment_success:error_budget_remaining", "legendFormat": "l1 commitment", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:merge_success:error_budget_remaining", "legendFormat": "merge", "refId": "D" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:node_availability:error_budget_remaining", "legendFormat": "availability", "refId": "E" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Burn rate (1h) — page at 14.4x, ticket at 6x",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 10,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 6 }, { "color": "red", "value": 14.4 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "lastNotNull"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:submit_ingress_availability:burn_rate1h", "legendFormat": "submit ingress", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:tx_end_to_end_success:burn_rate1h", "legendFormat": "e2e tx", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:l1_commitment_success:burn_rate1h", "legendFormat": "l1 commitment", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:merge_success:burn_rate1h", "legendFormat": "merge", "refId": "D" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "slo:node_availability:burn_rate1h", "legendFormat": "availability", "refId": "E" }
      ]
    },
    {
      "type": "row",
      "title": "Availability & stability",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 11,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Availability (up, selected range)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 24 },
      "id": 12,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "yellow", "value": 0.99 }, { "color": "green", "value": 0.999 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "avg_over_time(up{job=\"sundial_nodes\"}[$__range])", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Restarts (selected range)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 24 },
      "id": 13,
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 1 } ] } },
        "overrides": []
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "changes(max(midgard_node_start_time_seconds{job=\"sundial_nodes\"})[$__range:1m])", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scrape health (up)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 24 },
      "id": 14,
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "up{job=\"sundial_nodes\"}", "legendFormat": "{{instance}} {{role}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Block cadence (committed blocks/s, rate 5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 29 },
      "id": 15,
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(commit_block_count_total{job=\"sundial_nodes\"}[5m]))", "legendFormat": "blocks/s", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failure signals (increase over 1h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 29 },
      "id": 16,
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(commit_block_commitment_failures_total{job=\"sundial_nodes\"}[1h]))", "legendFormat": "commitment failures", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(merge_block_failures_total{job=\"sundial_nodes\"}[1h]))", "legendFormat": "merge failures", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(submit_block_failures_total{job=\"sundial_nodes\"}[1h]))", "legendFormat": "submit failures", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(tx_stream_fail_total{job=\"sundial_nodes\"}[1h]))", "legendFormat": "tx processing failures", "refId": "D" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(tx_stream_dead_letter_total{job=\"sundial_nodes\"}[1h]))", "legendFormat": "dead-letter txs", "refId": "E" }
      ]
    }
  ]
}
