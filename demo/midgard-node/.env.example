COMPOSE_PROJECT_NAME=sundial
L1_PROVIDER=Kupmios
L1_BLOCKFROST_API_URL=
L1_BLOCKFROST_KEY=
L1_OGMIOS_KEY=
L1_KUPO_KEY=
L1_OPERATOR_SEED_PHRASE=
L1_OPERATOR_SEED_PHRASE_FOR_BLOCK_COMMITMENT=
L1_OPERATOR_SEED_PHRASE_FOR_MERGE_TX=
NETWORK=Preprod
PORT=3000
WAIT_BETWEEN_BLOCK_COMMITMENTS=500
WAIT_BETWEEN_BLOCK_SUBMISSIONS=1000
SUBMIT_SIGNED_TX_TIMEOUT_MS=30000
SUBMIT_SIGN_TIMEOUT_RECOVERY_MAX_RETRIES=1
WAIT_BETWEEN_USER_EVENT_FETCHES=11000
WAIT_BETWEEN_MERGE_TXS=10000
COMMITMENT_WORKER_TIMEOUT_MS=300000
COMMITMENT_MAX_UNSUBMITTED_BLOCK_BACKLOG=0
COMMITMENT_WINDOW_WARN_TX_REQUESTS=50000
COMMITMENT_WINDOW_WARN_TOTAL_EVENTS=60000
COMMITMENT_WINDOW_WARN_TOTAL_BYTES=20000000
# Tx-only windows can wait for a fuller batch before forcing a commitment.
COMMITMENT_MIN_TX_REQUESTS_PER_BLOCK=1
COMMITMENT_MAX_WAIT_MS=0
COMMITMENT_MAX_TX_REQUESTS_PER_BLOCK=2000
TX_QUEUE_DRAIN_BATCH_SIZE=100
TX_QUEUE_PROCESSOR_INTERVAL_MS=250
TX_QUEUE_CLAIM_IDLE_MS=30000
TX_QUEUE_CLAIM_BATCH_SIZE=100
TX_QUEUE_MAX_DELIVERY_ATTEMPTS=5
TX_QUEUE_DEAD_LETTER_STREAM=midgard:tx-submissions:dead-letter
TX_PARSE_CONCURRENCY=8
NODE_ROLE=all
REDIS_STREAM_CONSUMER_NAME_API=midgard-node-api
REDIS_STREAM_CONSUMER_NAME_TX_PROCESSOR=midgard-node-tx-processor
REDIS_STREAM_CONSUMER_NAME_SEQUENCER=midgard-node-sequencer
REDIS_URL=redis://redis:6379
REDIS_STREAM_KEY=midgard:tx-submissions
REDIS_STREAM_CONSUMER_GROUP=midgard-tx-processors
REDIS_STREAM_CONSUMER_NAME=midgard-node-1
REDIS_STREAM_BLOCK_MS=1000
PROM_METRICS_PORT=9464
NODE_TX_PROCESSOR_PROM_HOST_PORT=9466
NODE_SEQUENCER_PROM_HOST_PORT=9467
OLTP_EXPORTER_URL="http://tempo:4318/v1/traces"
# Local Prometheus TSDB retention (backward reliability reporting needs history
# older than the 15d default). Time-based cap plus a disk-size safety net.
PROMETHEUS_RETENTION_TIME=120d
PROMETHEUS_RETENTION_SIZE=40GB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=midgard
POSTGRES_HOST=postgres
LEDGER_MPT_DB_PATH=midgard-ledger-mpt-db
MEMPOOL_MPT_DB_PATH=midgard-mempool-mpt-db
LUCID_INIT_MAX_RETRIES=
TESTNET_GENESIS_WALLET_SEED_PHRASE_A="panther fly crawl express smile lend company blue slogan dawn wall tip angle tomorrow battle myth category vanish misery ocean include salon wood rail"
TESTNET_GENESIS_WALLET_SEED_PHRASE_B="second salad helmet humble left noise inform person swamp surround twice animal fitness sing laundry saddle stove guess cabin rural kidney reject oil fee"
TESTNET_GENESIS_WALLET_SEED_PHRASE_C="cactus chalk grit reopen true slight whale sand law sibling silver fringe cement twist process bracket history leopard churn federal coral three hockey fossil"
# Dedicated faucet wallet. Use a fresh seed — never reuse a genesis/operator
# seed. Only funded/required when FAUCET_ENABLED=true.
FAUCET_ENABLED=false
FAUCET_SEED_PHRASE=
FAUCET_API_KEY=
FAUCET_AMOUNT_LOVELACE=100000000
FAUCET_COOLDOWN_SECONDS=86400
FAUCET_DAILY_IP_LIMIT=5
FAUCET_MIN_BALANCE_LOVELACE=100000000
FAUCET_GENESIS_ALLOCATION_LOVELACE=10000000000000
