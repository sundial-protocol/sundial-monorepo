{
  "name": "sundial-node",
  "version": "1.0.0",
  "description": "A CLI application for submitting/receiving L2 transactions and committing/merging Midgard blocks",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "sundial-node": "./dist/index.js"
  },
  "scripts": {
    "clean": "rimraf dist node_modules",
    "build": "tsup src/index.ts --minify --format esm && tsup src/workers/* --minify --format esm",
    "type-check": "pnpm exec tsc -p tsconfig.json --skipLibCheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format-check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "listen": "pnpm run build && node dist/index.js listen",
    "init": "pnpm run build && node dist/index.js init",
    "test": "NODE_ENV=emulator vitest run --config vitest.config.ts",
    "docker:up:node": "docker compose up -d sundial-node",
    "docker:up:postgres": "docker compose up -d postgres",
    "docker:up:prometheus": "docker compose up -d prometheus",
    "docker:up:loki": "docker compose up -d loki",
    "docker:up:promtail": "docker compose up -d promtail",
    "docker:up:cadvisor": "docker compose up -d cadvisor",
    "docker:up:grafana": "docker compose up -d grafana",
    "docker:up:tempo-init": "docker compose up -d tempo-init",
    "docker:up:tempo": "docker compose up -d tempo",
    "docker:up:all": "npm run docker:up:node && npm run docker:up:postgres && npm run docker:up:prometheus && npm run docker:up:loki && npm run docker:up:promtail && npm run docker:up:cadvisor && npm run docker:up:grafana && npm run docker:up:tempo-init && npm run docker:up:tempo",
    "docker:down:node": "docker compose rm -sfv sundial-node",
    "docker:down:postgres": "docker compose rm -sfv postgres",
    "docker:down:prometheus": "docker compose rm -sfv prometheus",
    "docker:down:loki": "docker compose rm -sfv loki",
    "docker:down:promtail": "docker compose rm -sfv promtail",
    "docker:down:cadvisor": "docker compose rm -sfv cadvisor",
    "docker:down:grafana": "docker compose rm -sfv grafana",
    "docker:down:tempo-init": "docker compose rm -sfv tempo-init",
    "docker:down:tempo": "docker compose rm -sfv tempo",
    "docker:down:all": "npm run docker:down:node && npm run docker:down:postgres && npm run docker:down:prometheus && npm run docker:down:loki && npm run docker:down:promtail && npm run docker:down:cadvisor && npm run docker:down:grafana && npm run docker:down:tempo-init && npm run docker:down:tempo",
    "docker:restart:node:simple": "docker compose up -d --no-deps --force-recreate sundial-node",
    "docker:restart:node:full": "docker compose up -d --no-deps --build --force-recreate sundial-node",
    "docker:restart:postgres": "docker compose up -d --no-deps --force-recreate postgres",
    "docker:restart:prometheus": "docker compose up -d --no-deps --force-recreate prometheus",
    "docker:restart:loki": "docker compose up -d --no-deps --force-recreate loki",
    "docker:restart:promtail": "docker compose up -d --no-deps --force-recreate promtail",
    "docker:restart:cadvisor": "docker compose up -d --no-deps --force-recreate cadvisor",
    "docker:restart:grafana": "docker compose up -d --no-deps --force-recreate grafana",
    "docker:restart:tempo-init": "docker compose up -d --no-deps --force-recreate tempo-init",
    "docker:restart:tempo": "docker compose up -d --no-deps --force-recreate tempo",
    "docker:restart:all": "npm run docker:restart:node:full && npm run docker:restart:postgres && npm run docker:restart:prometheus && npm run docker:restart:loki && npm run docker:restart:promtail && npm run docker:restart:cadvisor && npm run docker:restart:grafana && npm run docker:restart:tempo-init && npm run docker:restart:tempo",
    "infra:format:check": "bash ./scripts/infra/aws-fmt.sh check",
    "infra:format:fix": "bash ./scripts/infra/aws-fmt.sh fix",
    "infra:terraform:check": "npm run -s infra:testnet:validate && npm run -s infra:mainnet:validate",
    "infra:check:all": "npm run -s infra:terraform:check",
    "infra:testnet:bootstrap": "npm run infra:testnet:bootstrap:state && npm run infra:testnet:bootstrap:secrets && npm run infra:testnet:images:push",
    "infra:testnet:bootstrap:state": "bash ./scripts/infra/aws-bootstrap.sh state --environment=testnet",
    "infra:testnet:bootstrap:secrets": "bash ./scripts/infra/aws-bootstrap.sh secrets --environment=testnet",
    "infra:testnet:images:push": "bash ./scripts/infra/aws-bootstrap.sh ecr --environment=testnet",
    "infra:testnet:apply": "npm run infra:testnet:apply:shared && npm run infra:testnet:apply:node && npm run infra:testnet:apply:obs",
    "infra:testnet:apply:dry-run": "npm run infra:testnet:apply",
    "infra:testnet:apply:commit": "IS_NOT_DRY_RUN=true npm run infra:testnet:apply",
    "infra:testnet:apply:shared": "bash ./scripts/infra/aws-apply.sh apply --environment=testnet --service=shared && npm run -s infra:testnet:plan:if-dry-run:shared",
    "infra:testnet:apply:node": "bash ./scripts/infra/aws-apply.sh apply --environment=testnet --service=sundial-node && npm run -s infra:testnet:plan:if-dry-run:node",
    "infra:testnet:apply:obs": "bash ./scripts/infra/aws-apply.sh apply --environment=testnet --service=obs && npm run -s infra:testnet:plan:if-dry-run:obs",
    "infra:testnet:destroy:node": "bash ./scripts/infra/aws-destroy.sh --environment=testnet --service=sundial-node && npm run -s infra:testnet:plan:if-dry-run:node",
    "infra:testnet:destroy:commit:node": "IS_NOT_DRY_RUN=true npm run infra:testnet:destroy:node",
    "infra:testnet:live": "bash ./scripts/infra/aws-ecs-live.sh --environment=testnet --service=all",
    "infra:testnet:logs": "bash ./scripts/infra/aws-ecs-logs.sh --environment=testnet --service=all --since=30m",
    "infra:testnet:logs:node": "bash ./scripts/infra/aws-ecs-logs.sh --environment=testnet --service=sundial-node --since=30m",
    "infra:testnet:output": "bash ./scripts/infra/aws-apply.sh output --environment=testnet",
    "infra:testnet:plan": "bash ./scripts/infra/aws-plan.sh --environment=testnet",
    "infra:testnet:plan:node": "bash ./scripts/infra/aws-plan.sh --environment=testnet --service=sundial-node",
    "infra:testnet:plan:obs": "bash ./scripts/infra/aws-plan.sh --environment=testnet --service=obs",
    "infra:testnet:plan:rds": "bash ./scripts/infra/aws-plan.sh --environment=testnet --service=rds",
    "infra:testnet:plan:shared": "bash ./scripts/infra/aws-plan.sh --environment=testnet --service=shared",
    "infra:testnet:plan:if-dry-run:node": "bash -c 'if [[ \"${IS_NOT_DRY_RUN:-}\" != \"true\" ]]; then npm run -s infra:testnet:plan:node; fi'",
    "infra:testnet:plan:if-dry-run:obs": "bash -c 'if [[ \"${IS_NOT_DRY_RUN:-}\" != \"true\" ]]; then npm run -s infra:testnet:plan:obs; fi'",
    "infra:testnet:plan:if-dry-run:shared": "bash -c 'if [[ \"${IS_NOT_DRY_RUN:-}\" != \"true\" ]]; then npm run -s infra:testnet:plan:shared; fi'",
    "infra:testnet:release:tag:node": "node ./scripts/infra/release-tag.mjs --environment=testnet --branch=testnet --service=sundial-node",
    "infra:testnet:restart": "bash ./scripts/infra/aws-ecs-restart.sh --environment=testnet --service=all",
    "infra:testnet:restart:node": "bash ./scripts/infra/aws-ecs-restart.sh --environment=testnet --service=sundial-node",
    "infra:testnet:validate": "bash ./scripts/infra/aws-apply.sh validate --environment=testnet",
    "infra:testnet:ver:node": "node ./scripts/infra/service-version.mjs --environment=testnet --service=sundial-node",
    "infra:mainnet:bootstrap": "npm run infra:mainnet:bootstrap:state && npm run infra:mainnet:bootstrap:secrets && npm run infra:mainnet:images:push",
    "infra:mainnet:bootstrap:state": "bash ./scripts/infra/aws-bootstrap.sh state --environment=mainnet",
    "infra:mainnet:bootstrap:secrets": "bash ./scripts/infra/aws-bootstrap.sh secrets --environment=mainnet",
    "infra:mainnet:images:push": "bash ./scripts/infra/aws-bootstrap.sh ecr --environment=mainnet",
    "infra:mainnet:apply": "npm run infra:mainnet:apply:shared && npm run infra:mainnet:apply:node && npm run infra:mainnet:apply:obs",
    "infra:mainnet:apply:dry-run": "npm run infra:mainnet:apply",
    "infra:mainnet:apply:commit": "IS_NOT_DRY_RUN=true npm run infra:mainnet:apply",
    "infra:mainnet:apply:shared": "bash ./scripts/infra/aws-apply.sh apply --environment=mainnet --service=shared && npm run -s infra:mainnet:plan:if-dry-run:shared",
    "infra:mainnet:apply:node": "bash ./scripts/infra/aws-apply.sh apply --environment=mainnet --service=sundial-node && npm run -s infra:mainnet:plan:if-dry-run:node",
    "infra:mainnet:apply:obs": "bash ./scripts/infra/aws-apply.sh apply --environment=mainnet --service=obs && npm run -s infra:mainnet:plan:if-dry-run:obs",
    "infra:mainnet:destroy:node": "bash ./scripts/infra/aws-destroy.sh --environment=mainnet --service=sundial-node && npm run -s infra:mainnet:plan:if-dry-run:node",
    "infra:mainnet:destroy:commit:node": "IS_NOT_DRY_RUN=true npm run infra:mainnet:destroy:node",
    "infra:mainnet:live": "bash ./scripts/infra/aws-ecs-live.sh --environment=mainnet --service=all",
    "infra:mainnet:logs": "bash ./scripts/infra/aws-ecs-logs.sh --environment=mainnet --service=all --since=30m",
    "infra:mainnet:logs:node": "bash ./scripts/infra/aws-ecs-logs.sh --environment=mainnet --service=sundial-node --since=30m",
    "infra:mainnet:output": "bash ./scripts/infra/aws-apply.sh output --environment=mainnet",
    "infra:mainnet:plan": "bash ./scripts/infra/aws-plan.sh --environment=mainnet",
    "infra:mainnet:plan:node": "bash ./scripts/infra/aws-plan.sh --environment=mainnet --service=sundial-node",
    "infra:mainnet:plan:obs": "bash ./scripts/infra/aws-plan.sh --environment=mainnet --service=obs",
    "infra:mainnet:plan:rds": "bash ./scripts/infra/aws-plan.sh --environment=mainnet --service=rds",
    "infra:mainnet:plan:shared": "bash ./scripts/infra/aws-plan.sh --environment=mainnet --service=shared",
    "infra:mainnet:plan:if-dry-run:node": "bash -c 'if [[ \"${IS_NOT_DRY_RUN:-}\" != \"true\" ]]; then npm run -s infra:mainnet:plan:node; fi'",
    "infra:mainnet:plan:if-dry-run:obs": "bash -c 'if [[ \"${IS_NOT_DRY_RUN:-}\" != \"true\" ]]; then npm run -s infra:mainnet:plan:obs; fi'",
    "infra:mainnet:plan:if-dry-run:shared": "bash -c 'if [[ \"${IS_NOT_DRY_RUN:-}\" != \"true\" ]]; then npm run -s infra:mainnet:plan:shared; fi'",
    "infra:mainnet:release:tag:node": "node ./scripts/infra/release-tag.mjs --environment=mainnet --branch=mainnet --service=sundial-node",
    "infra:mainnet:restart": "bash ./scripts/infra/aws-ecs-restart.sh --environment=mainnet --service=all",
    "infra:mainnet:restart:node": "bash ./scripts/infra/aws-ecs-restart.sh --environment=mainnet --service=sundial-node",
    "infra:mainnet:validate": "bash ./scripts/infra/aws-apply.sh validate --environment=mainnet",
    "infra:mainnet:ver:node": "node ./scripts/infra/service-version.mjs --environment=mainnet --service=sundial-node"
  },
  "keywords": [
    "cardano",
    "layer2",
    "midgard",
    "anastasia-labs"
  ],
  "author": "Anastasia Labs",
  "license": "ISC",
  "dependencies": {
    "@aiken-lang/merkle-patricia-forestry": "^1.3.1",
    "@al-ft/midgard-sdk": "workspace:*",
    "@effect/cluster": "^0.58.2",
    "@effect/experimental": "^0.60.0",
    "@effect/opentelemetry": "^0.63.0",
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.106.0",
    "@effect/rpc": "^0.75.1",
    "@effect/sql": "^0.51.1",
    "@effect/sql-pg": "^0.52.1",
    "@electric-sql/pglite": "^0.4.5",
    "@ethereumjs/mpt": "7.0.0-alpha.1",
    "@ethereumjs/util": "^9.1.0",
    "@harmoniclabs/crypto": "^0.3.0",
    "@lucid-evolution/lucid": "^0.4.30",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.217.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "dotenv": "^16.6.1",
    "effect": "^3.21.2",
    "level": "^10.0.0",
    "memory-level": "^3.1.0",
    "rimraf": "^6.1.3",
    "vitest": "3.2.4"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^13.1.0",
    "@effect/vitest": "^0.29.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.18",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.2"
  },
  "overrides": {
    "ip-address": "10.2.0",
    "@cardano-sdk/core": "0.46.12"
  }
}
